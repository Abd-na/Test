# ───────────── Veta Messenger ─────────────
NODE_ENV=production
HOST=127.0.0.1
PORT=3100
# Public URL behind Nginx (used in pairing QR codes and media links)
PUBLIC_URL=https://msg.veta.example.com
TRUST_PROXY=1
LOG_LEVEL=info

APP_NAME=Veta
# Random 32+ chars. Generate: openssl rand -hex 32
APP_SECRET=
# Dashboard password
ADMIN_PASSWORD=

# ───────────── Database (same MySQL as Veta) ─────────────
# Copy these from Veta's .env. Tables are created automatically with the vm_ prefix.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=veta
DB_USERNAME=veta
DB_PASSWORD=
# DB_SOCKET=/var/run/mysqld/mysqld.sock

# Country code used for local numbers that start with 0 (e.g. 964 Iraq, 966 Saudi Arabia)
DEFAULT_COUNTRY_CODE=964

# ───────────── WhatsApp ─────────────
# Random pause between messages per number (anti-ban)
WA_MIN_DELAY_MS=2500
WA_MAX_DELAY_MS=6000
# Show "typing…" before sending
WA_TYPING=true
# Mark incoming messages as read automatically
WA_AUTO_READ=false
WA_DOWNLOAD_MEDIA=true

# ───────────── SMS (Android phones) ─────────────
SMS_MIN_DELAY_MS=1500
SMS_QUEUE_TIMEOUT_SEC=600
SMS_SEND_TIMEOUT_SEC=300
SMS_DEVICE_ONLINE_SEC=90

# ───────────── Messages / OTP ─────────────
MESSAGE_MAX_ATTEMPTS=3
OTP_LENGTH=6
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=60
OTP_MAX_PER_HOUR=5
# Placeholders: {code} {minutes} {app}. Use \n for new lines.
OTP_TEMPLATE="رمز التحقق الخاص بك في {app} هو: {code}\nصالح لمدة {minutes} دقائق. لا تشاركه مع أي أحد."

MEDIA_DIR=./data/media
MEDIA_MAX_MB=16
